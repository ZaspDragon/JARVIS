{
  "name": "JARVIS Scheduled Services",
  "active": false,
  "settings": { "executionOrder": "v1", "saveDataErrorExecution": "all", "saveDataSuccessExecution": "none" },
  "nodes": [
    { "id": "morning", "name": "Morning Briefing", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [-800,-300], "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 8 * * 1-5" }] } } },
    { "id": "warehouse", "name": "Warehouse Watcher", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [-800,-100], "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "*/30 7-17 * * 1-5" }] } } },
    { "id": "github", "name": "App Health Watcher", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [-800,100], "parameters": { "rule": { "interval": [{ "field": "hours", "hoursInterval": 1 }] } } },
    { "id": "home", "name": "Household Reminder Check", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [-800,300], "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 7,18 * * *" }] } } },
    { "id": "trade", "name": "Trading Observer", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [-800,500], "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "15 9-16 * * 1-5" }] } } },
    { "id": "normalize", "name": "Build Guarded Event", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-430,100], "parameters": { "jsCode": "const source=$node.name; const scope=source.includes('Warehouse')?'work':source.includes('Household')?'household':source.includes('Trading')?'hobby':'private'; return [{json:{event_id:`${source}:${new Date().toISOString().slice(0,13)}`,source,scope,approval_required:source.includes('Trading'),emergency_pause:process.env.JARVIS_EMERGENCY_PAUSE==='true',created_at:new Date().toISOString()}}];" } },
    { "id": "pause", "name": "Emergency Pause", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [-170,100], "parameters": { "conditions": { "options": { "caseSensitive": true }, "conditions": [{ "leftValue": "={{$json.emergency_pause}}", "rightValue": true, "operator": { "type": "boolean", "operation": "false", "singleValue": true } }] } } },
    { "id": "approval", "name": "Approval Gate", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [90,100], "parameters": { "conditions": { "options": { "caseSensitive": true }, "conditions": [{ "leftValue": "={{$json.approval_required}}", "rightValue": true, "operator": { "type": "boolean", "operation": "false", "singleValue": true } }] } } },
    { "id": "dispatch", "name": "Dispatch Read-Only Work", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [350,20], "parameters": { "method": "POST", "url": "={{$env.JARVIS_APP_URL + '/api/n8n/events'}}", "sendBody": true, "contentType": "raw", "rawContentType": "application/json", "body": "={{JSON.stringify($json)}}", "options": { "timeout": 30000 } } },
    { "id": "queue", "name": "Queue Approval", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [350,190], "parameters": { "method": "POST", "url": "={{$env.JARVIS_APP_URL + '/api/n8n/approvals'}}", "sendBody": true, "contentType": "raw", "rawContentType": "application/json", "body": "={{JSON.stringify({...$json,status:'pending',expires_at:new Date(Date.now()+15*60*1000).toISOString()} )}}", "options": { "timeout": 30000 } } }
  ],
  "connections": {
    "Morning Briefing": { "main": [[{ "node": "Build Guarded Event", "type": "main", "index": 0 }]] },
    "Warehouse Watcher": { "main": [[{ "node": "Build Guarded Event", "type": "main", "index": 0 }]] },
    "App Health Watcher": { "main": [[{ "node": "Build Guarded Event", "type": "main", "index": 0 }]] },
    "Household Reminder Check": { "main": [[{ "node": "Build Guarded Event", "type": "main", "index": 0 }]] },
    "Trading Observer": { "main": [[{ "node": "Build Guarded Event", "type": "main", "index": 0 }]] },
    "Build Guarded Event": { "main": [[{ "node": "Emergency Pause", "type": "main", "index": 0 }]] },
    "Emergency Pause": { "main": [[{ "node": "Approval Gate", "type": "main", "index": 0 }]] },
    "Approval Gate": { "main": [[{ "node": "Dispatch Read-Only Work", "type": "main", "index": 0 }],[{ "node": "Queue Approval", "type": "main", "index": 0 }]] }
  },
  "pinData": {},
  "versionId": "jarvis-scheduled-services-v1"
}
